{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\main_temp.exe", // Temporary output file name
                "-Isrc/include", // SDL2 include path
                "-Lsrc/lib",     // SDL2 library path
                "-lSDL2",        // Link SDL2
                "-lSDL2main",    // Link SDL2main
                "-lSDL2_image",  // Link SDL2_image
                "-lSDL2_mixer",  // Link SDL2_mixer
                "-lSDL2_ttf",    // Link SDL2_ttf
                "-lstdc++"       // Link the standard C++ library
            ],
            "options": {
                "cwd": "${workspaceFolder}" // Ensure the working directory is the project root
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}